# Production PostgreSQL connection string (Neon)
DATABASE_URL="postgresql://user:password@host/tablemate?sslmode=require"

# Dedicated Test PostgreSQL connection string (Neon test branch)
TEST_DATABASE_URL="postgresql://user:password@test-host/tablemate?sslmode=require"

# Secret key for signing session cookies
SESSION_SECRET="replace-with-a-random-32-byte-hex-secret"

# WhatsApp Cloud API credentials (Meta Graph API)
WHATSAPP_VERIFY_TOKEN="replace-with-webhook-verify-token"
WHATSAPP_APP_SECRET="replace-with-meta-app-secret"
WHATSAPP_ACCESS_TOKEN="replace-with-system-user-or-temp-access-token"
WHATSAPP_API_VERSION="v22.0"

# Optional environment settings
NODE_ENV="development"
PORT=3000
